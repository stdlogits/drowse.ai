{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polythetic.ai/schemas/release-corpus-v2.json",
  "title": "Drowse hosted SAE release corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "algorithm",
    "generatorSha256",
    "sourceManifestSha256",
    "source",
    "license",
    "selection",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "const": "https://polythetic.ai/schemas/release-corpus-v2.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "algorithm": {
      "const": "drowse-release-corpus-v1"
    },
    "generatorSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "$ref": "https://polythetic.ai/schemas/release-corpus-source-v2.json#/$defs/source"
    },
    "license": {
      "$ref": "https://polythetic.ai/schemas/release-corpus-source-v2.json#/$defs/license"
    },
    "selection": {
      "$ref": "https://polythetic.ai/schemas/release-corpus-source-v2.json#/$defs/selection"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sae"
      ],
      "properties": {
        "sae": {
          "$ref": "#/$defs/corpusOutput"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "corpusOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "documents",
        "characters"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "documents": {
          "$ref": "#/$defs/positiveInteger"
        },
        "characters": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    }
  }
}
