--- /dev/null
+++ b/python/mlc_llm/model/drowse_units.py
@@ -0,0 +1,1327 @@
+"""Drowse hook ABI v5 (`block-sites-v5`): in-block unit sites for dense blocks.
+
+Every eligible model's decoder layer runs `drowse_block(hidden, cache, layer_id, sites)`. With
+`NO_SITES` the block is op for op the upstream layer (the v4 graph); `UnitSites` inserts, per
+layer, exact mean-ablation of heads at the output-projection input and of neurons at the
+down-projection input (`x <- x * keep + bias` on rows whose absolute position is at least
+`UNIT_POSITIONS_FROM`), and the live unit tap at the forward's last row. Layouts and semantics:
+drowse.ai `browser-runtime/HOOK_ABI.md` (B1 §2.2, §3.1, §3.4, §3.5).
+"""
+
+import struct
+
+from tvm import tirx
+from tvm.relax.frontend import nn
+from tvm.relax.frontend.nn import Tensor, op
+from tvm.script import tirx as T
+
+UNIT_MAX_GROUPS = 4
+UNIT_MAX_NEURON_ABLATIONS = 256
+UNIT_MAX_HEAD_ABLATIONS = 64
+UNIT_MAX_TAPS = 64
+UNIT_MAX_HEAD_TAPS = 16
+UNIT_MAX_ACTIVITY_TRACES = 32
+UNIT_MAX_ACTIVITY_SPANS = 4
+UNIT_MAX_PATTERN_LAYERS = 8
+UNIT_MAX_PATTERN_HEADS = 16
+UNIT_MAX_LENS_READ_TOP_K = 256
+UNIT_MAX_ANATOMY_UNITS = 64
+UNIT_POSITIONS_FROM = 1
+DROWSE_KERNEL_STORAGE_BINDINGS = 8
+
+HOOK_PROFILE_SCHEMA_VERSION = 4
+HOOK_PROFILE_ID = 4
+BLOCK_SITES_HOOK_ABI_VERSION = 5
+STRUCTURED_HOOK_FORMAT_VERSION = 4
+BLOCK_SITES_EXACT_READOUT_ABI_VERSION = 2
+
+ACTIVATION_SILU = 1
+ACTIVATION_GELU_TANH = 2
+
+_LANES = 64
+
+
+def unit_meta_layout(num_layers: int) -> dict[str, tuple[int, int]]:
+    """`(offset, length)` of each u32 table in `unit_meta` (HOOK_ABI.md §4)."""
+    fields = (
+        ("neuron_offsets", num_layers + 1),
+        ("neuron_index", UNIT_MAX_NEURON_ABLATIONS),
+        ("neuron_group", UNIT_MAX_NEURON_ABLATIONS),
+        ("head_offsets", num_layers + 1),
+        ("head_index", UNIT_MAX_HEAD_ABLATIONS),
+        ("head_group", UNIT_MAX_HEAD_ABLATIONS),
+        ("tap_neuron_offsets", num_layers + 1),
+        ("tap_neuron_index", UNIT_MAX_TAPS),
+        ("tap_neuron_slot", UNIT_MAX_TAPS),
+        ("tap_head_offsets", num_layers + 1),
+        ("tap_head_index", UNIT_MAX_HEAD_TAPS),
+        ("tap_head_slot", UNIT_MAX_HEAD_TAPS),
+    )
+    return _pack(fields)
+
+
+def unit_coeff_layout(head_dim: int) -> dict[str, tuple[int, int]]:
+    """`(offset, length)` of each f32 table in `unit_coeff`."""
+    return _pack((
+        ("neuron_keep", UNIT_MAX_NEURON_ABLATIONS),
+        ("neuron_bias", UNIT_MAX_NEURON_ABLATIONS),
+        ("head_keep", UNIT_MAX_HEAD_ABLATIONS),
+        ("head_bias", UNIT_MAX_HEAD_ABLATIONS * head_dim),
+    ))
+
+
+def _pack(fields) -> dict[str, tuple[int, int]]:
+    out, offset = {}, 0
+    for name, length in fields:
+        out[name] = (offset, length)
+        offset += length
+    out["__length__"] = (offset, 0)
+    return out
+
+
+def unit_program_spec(num_layers: int, head_dim: int) -> dict[str, nn.spec.Tensor]:
+    """The unit section's arguments, after the curved program's (B1 §3.4)."""
+    return {
+        "unit_meta": nn.spec.Tensor([unit_meta_layout(num_layers)["__length__"][0]], "uint32"),
+        "unit_coeff": nn.spec.Tensor([unit_coeff_layout(head_dim)["__length__"][0]], "float32"),
+        "unit_active": nn.spec.Tensor([UNIT_MAX_GROUPS], "float32"),
+        "tap_grams": nn.spec.Tensor([UNIT_MAX_HEAD_TAPS, head_dim, head_dim], "float32"),
+    }
+
+
+def float32_bits(value: float) -> int:
+    return struct.unpack("<i", struct.pack("<f", value))[0]
+
+
+def hook_profile_values(base: tuple, block: dict | None, context_tokens: int,
+                        prefill_chunk_size: int, hidden_size: int) -> tuple:
+    """Descriptor schema 4: v3's 31 fields (ABI 5, format 4, readout 2 in `base`), then the block
+    and unit fields. A residual library (`block is None`) reports 0 in every block field, unit
+    capacity, `ANATOMY_STRIDE`, `UNIT_POSITIONS_FROM` and `MAX_ANATOMY_UNITS`."""
+    units = block is not None
+    spec = block or {}
+
+    def bits(key):
+        value = spec.get(key)
+        return 0 if value is None else float32_bits(value)
+
+    def cap(value):
+        return value if units else 0
+
+    anatomy_stride = (
+        6 * hidden_size + spec["d_ff"] + spec["n_heads"] * spec["head_dim"] if units else 0
+    )
+    return base + (
+        int(units),
+        spec.get("d_ff", 0),
+        spec.get("n_heads", 0),
+        spec.get("n_kv_heads", 0),
+        spec.get("head_dim", 0),
+        int(spec.get("sandwich", False)),
+        spec.get("norm_offset", 0),
+        spec.get("activation", 0),
+        bits("embed_scale"),
+        bits("rms_eps"),
+        int(spec.get("qk_norm", False)),
+        bits("attn_scaling"),
+        bits("attn_logit_softcap"),
+        bits("final_logit_softcap"),
+        bits("rope_theta"),
+        bits("rope_local_theta"),
+        bits("rope_global_scale"),
+        int(spec.get("rope_in_graph", False)),
+        spec.get("sliding_window") or 0,
+        spec.get("sliding_pattern") or 0,
+        prefill_chunk_size,
+        cap(UNIT_MAX_GROUPS),
+        cap(UNIT_MAX_NEURON_ABLATIONS),
+        cap(UNIT_MAX_HEAD_ABLATIONS),
+        cap(UNIT_MAX_TAPS),
+        cap(UNIT_MAX_HEAD_TAPS),
+        cap(UNIT_MAX_ACTIVITY_TRACES),
+        cap(UNIT_MAX_ACTIVITY_SPANS),
+        cap(UNIT_MAX_PATTERN_LAYERS),
+        cap(UNIT_MAX_PATTERN_HEADS),
+        anatomy_stride,
+        UNIT_POSITIONS_FROM if units else 0,
+        UNIT_MAX_LENS_READ_TOP_K,
+        UNIT_MAX_ANATOMY_UNITS if units else 0,
+        DROWSE_KERNEL_STORAGE_BINDINGS,
+        context_tokens,
+    )
+
+
+class NoSites:
+    """Sites compiled out: the block is the upstream layer. Every site hook receives the block's
+    own tensor; `head` and `neuron` return the tensor the block continues with, the observing
+    hooks (`tap`, `mid`, `mlp`) return nothing."""
+
+    def head(self, z: Tensor, layer_id: int) -> Tensor:
+        return z
+
+    def mid(self, h_mid: Tensor, layer_id: int) -> None:
+        return None
+
+    def mlp(self, mlp_o: Tensor, layer_id: int) -> None:
+        return None
+
+    def neuron(self, act: Tensor, layer_id: int) -> Tensor:
+        return act
+
+    def tap(self, z: Tensor, attn_o: Tensor, act: Tensor, layer_id: int) -> None:
+        return None
+
+    def qkv(self, qkv: Tensor, layer_id: int) -> None:
+        """The attention input `[b, s, H + 2·KV, hd]` after the q/k norms (and, on Gemma 3, the
+        in-graph rotary): the pattern capture's source (B1 §6)."""
+        return None
+
+    def block_in(self, hidden: Tensor, layer_id: int) -> None:
+        return None
+
+    def out_pre(self, hidden: Tensor, layer_id: int) -> None:
+        return None
+
+    def out(self, hidden: Tensor, layer_id: int) -> None:
+        return None
+
+
+NO_SITES = NoSites()
+
+
+class UnitSites(NoSites):
+    """Mean-ablation and the live unit tap (B1 §2.2, §3.1), one forward's worth."""
+
+    def __init__(
+        self,
+        num_layers: int,
+        head_dim: int,
+        positions: Tensor,
+        unit_meta: Tensor,
+        unit_coeff: Tensor,
+        unit_active: Tensor,
+        tap_grams: Tensor,
+        sandwich: bool,
+        rms_eps: float,
+    ):
+        self.num_layers = num_layers
+        self.head_dim = head_dim
+        self.positions = positions
+        self.unit_meta = unit_meta
+        self.unit_coeff = unit_coeff
+        self.unit_active = unit_active
+        self.tap_grams = tap_grams
+        self.sandwich = sandwich
+        self.rms_eps = rms_eps
+        self.taps = op.zeros((UNIT_MAX_TAPS,), "float32")
+
+    def head(self, z: Tensor, layer_id: int) -> Tensor:
+        return _head_ablate(z, layer_id, self)
+
+    def neuron(self, act: Tensor, layer_id: int) -> Tensor:
+        return _neuron_ablate(act, layer_id, self)
+
+    def tap(self, z: Tensor, attn_o: Tensor, act: Tensor, layer_id: int) -> None:
+        self.taps = _unit_tap(z, attn_o, act, layer_id, self)
+
+
+def _neuron_ablate(act: Tensor, layer_id: int, sites: UnitSites) -> Tensor:
+    batch_size, sequence_length, d_ff = act.shape
+    dtype = act.dtype
+    meta_len = sites.unit_meta.shape[0]
+    coeff_len = sites.unit_coeff.shape[0]
+    total = batch_size * sequence_length
+    meta = unit_meta_layout(sites.num_layers)
+    coeff = unit_coeff_layout(sites.head_dim)
+    offsets = meta["neuron_offsets"][0]
+    index_at = meta["neuron_index"][0]
+    group_at = meta["neuron_group"][0]
+    keep_at = coeff["neuron_keep"][0]
+    bias_at = coeff["neuron_bias"][0]
+    steps = (UNIT_MAX_NEURON_ABLATIONS + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _ablate(
+        var_act: T.handle,
+        var_positions: T.handle,
+        var_meta: T.handle,
+        var_coeff: T.handle,
+        var_active: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        values = T.match_buffer(var_act, (batch_size, sequence_length, d_ff), dtype)
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        unit_meta = T.match_buffer(var_meta, (meta_len,), "uint32")
+        unit_coeff = T.match_buffer(var_coeff, (coeff_len,), "float32")
+        active = T.match_buffer(var_active, (UNIT_MAX_GROUPS,), "float32")
+        for row in T.thread_binding(total, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_neuron_ablate"):
+                    r = T.axis.spatial(total, row)
+                    t = T.axis.spatial(_LANES, lane)
+                    if positions[r] >= UNIT_POSITIONS_FROM:
+                        for step in T.serial(steps):
+                            entry = T.meta_var(
+                                T.Cast("int32", unit_meta[offsets + layer_id]) + step * _LANES + t
+                            )
+                            if entry < T.Cast("int32", unit_meta[offsets + layer_id + 1]):
+                                if active[T.Cast("int32", unit_meta[group_at + entry])] != T.float32(0):
+                                    neuron = T.meta_var(T.Cast("int32", unit_meta[index_at + entry]))
+                                    b = T.meta_var(T.floordiv(r, sequence_length))
+                                    s = T.meta_var(T.floormod(r, sequence_length))
+                                    values[b, s, neuron] = T.Cast(
+                                        dtype,
+                                        T.Cast("float32", values[b, s, neuron]) * unit_coeff[keep_at + entry]
+                                        + unit_coeff[bias_at + entry],
+                                    )
+
+    return op.tensor_ir_inplace_op(
+        _ablate,
+        f"drowse_neuron_ablate_{layer_id}",
+        args=[act, sites.positions, sites.unit_meta, sites.unit_coeff, sites.unit_active],
+        inplace_indices=[0],
+        out=Tensor.placeholder(act.shape, dtype),
+    )
+
+
+def _head_ablate(z: Tensor, layer_id: int, sites: UnitSites) -> Tensor:
+    batch_size, sequence_length, width = z.shape
+    dtype = z.dtype
+    head_dim = sites.head_dim
+    meta_len = sites.unit_meta.shape[0]
+    coeff_len = sites.unit_coeff.shape[0]
+    total = batch_size * sequence_length
+    meta = unit_meta_layout(sites.num_layers)
+    coeff = unit_coeff_layout(head_dim)
+    offsets = meta["head_offsets"][0]
+    index_at = meta["head_index"][0]
+    group_at = meta["head_group"][0]
+    keep_at = coeff["head_keep"][0]
+    bias_at = coeff["head_bias"][0]
+    steps = (UNIT_MAX_HEAD_ABLATIONS * head_dim + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _ablate(
+        var_z: T.handle,
+        var_positions: T.handle,
+        var_meta: T.handle,
+        var_coeff: T.handle,
+        var_active: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        values = T.match_buffer(var_z, (batch_size, sequence_length, width), dtype)
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        unit_meta = T.match_buffer(var_meta, (meta_len,), "uint32")
+        unit_coeff = T.match_buffer(var_coeff, (coeff_len,), "float32")
+        active = T.match_buffer(var_active, (UNIT_MAX_GROUPS,), "float32")
+        for row in T.thread_binding(total, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_head_ablate"):
+                    r = T.axis.spatial(total, row)
+                    t = T.axis.spatial(_LANES, lane)
+                    if positions[r] >= UNIT_POSITIONS_FROM:
+                        first = T.meta_var(T.Cast("int32", unit_meta[offsets + layer_id]))
+                        count = T.meta_var(
+                            T.Cast("int32", unit_meta[offsets + layer_id + 1]) - first
+                        )
+                        for step in T.serial(steps):
+                            item = T.meta_var(step * _LANES + t)
+                            if item < count * head_dim:
+                                entry = T.meta_var(first + T.floordiv(item, head_dim))
+                                coordinate = T.meta_var(T.floormod(item, head_dim))
+                                if active[T.Cast("int32", unit_meta[group_at + entry])] != T.float32(0):
+                                    column = T.meta_var(
+                                        T.Cast("int32", unit_meta[index_at + entry]) * head_dim
+                                        + coordinate
+                                    )
+                                    b = T.meta_var(T.floordiv(r, sequence_length))
+                                    s = T.meta_var(T.floormod(r, sequence_length))
+                                    values[b, s, column] = T.Cast(
+                                        dtype,
+                                        T.Cast("float32", values[b, s, column]) * unit_coeff[keep_at + entry]
+                                        + unit_coeff[bias_at + entry * head_dim + coordinate],
+                                    )
+
+    return op.tensor_ir_inplace_op(
+        _ablate,
+        f"drowse_head_ablate_{layer_id}",
+        args=[z, sites.positions, sites.unit_meta, sites.unit_coeff, sites.unit_active],
+        inplace_indices=[0],
+        out=Tensor.placeholder(z.shape, dtype),
+    )
+
+
+def _unit_tap(z: Tensor, attn_o: Tensor, act: Tensor, layer_id: int, sites: UnitSites) -> Tensor:
+    """Writes this layer's tapped values at the forward's last row into `unit_taps`: a neuron's
+    `act`, a head's write norm `sqrt(max(0, z_h^T G_h z_h)) * r_ao` (B1 §2.2)."""
+    batch_size, sequence_length, width = z.shape
+    hidden_size = attn_o.shape[2]
+    d_ff = act.shape[2]
+    head_dim = sites.head_dim
+    meta_len = sites.unit_meta.shape[0]
+    meta = unit_meta_layout(sites.num_layers)
+    neuron_offsets = meta["tap_neuron_offsets"][0]
+    neuron_index = meta["tap_neuron_index"][0]
+    neuron_slot = meta["tap_neuron_slot"][0]
+    head_offsets = meta["tap_head_offsets"][0]
+    head_index = meta["tap_head_index"][0]
+    head_slot = meta["tap_head_slot"][0]
+    blocks = UNIT_MAX_TAPS + UNIT_MAX_HEAD_TAPS
+    sandwich = sites.sandwich
+    rms_eps = sites.rms_eps
+    z_dtype, o_dtype, act_dtype = z.dtype, attn_o.dtype, act.dtype
+    head_chunks = (head_dim + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _tap(
+        var_z: T.handle,
+        var_o: T.handle,
+        var_act: T.handle,
+        var_meta: T.handle,
+        var_grams: T.handle,
+        var_taps: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        zs = T.match_buffer(var_z, (batch_size, sequence_length, width), z_dtype)
+        outs = T.match_buffer(var_o, (batch_size, sequence_length, hidden_size), o_dtype)
+        acts = T.match_buffer(var_act, (batch_size, sequence_length, d_ff), act_dtype)
+        unit_meta = T.match_buffer(var_meta, (meta_len,), "uint32")
+        grams = T.match_buffer(var_grams, (UNIT_MAX_HEAD_TAPS, head_dim, head_dim), "float32")
+        taps = T.match_buffer(var_taps, (UNIT_MAX_TAPS,), "float32")
+        local_z = T.sblock_alloc_buffer((head_dim,), "float32", scope="shared")
+        partial = T.sblock_alloc_buffer((_LANES,), "float32", scope="shared")
+        scale = T.sblock_alloc_buffer((1,), "float32", scope="shared")
+        acc = T.sblock_alloc_buffer((1,), "float32", scope="local")
+        row_acc = T.sblock_alloc_buffer((1,), "float32", scope="local")
+        for block in T.thread_binding(blocks, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_unit_tap"):
+                    k = T.axis.spatial(blocks, block)
+                    t = T.axis.spatial(_LANES, lane)
+                    last_b = T.meta_var(batch_size - 1)
+                    last_s = T.meta_var(sequence_length - 1)
+                    if k < UNIT_MAX_TAPS:
+                        entry = T.meta_var(
+                            T.Cast("int32", unit_meta[neuron_offsets + layer_id]) + k
+                        )
+                        if T.And(
+                            entry < T.Cast("int32", unit_meta[neuron_offsets + layer_id + 1]),
+                            t == 0,
+                        ):
+                            taps[T.Cast("int32", unit_meta[neuron_slot + entry])] = T.Cast(
+                                "float32",
+                                acts[last_b, last_s, T.Cast("int32", unit_meta[neuron_index + entry])],
+                            )
+                    else:
+                        # Barriers stay in control flow that depends on the workgroup id only
+                        # (WGSL uniformity); the entry's validity guards loads and stores.
+                        entry = T.meta_var(
+                            T.Cast("int32", unit_meta[head_offsets + layer_id]) + k - UNIT_MAX_TAPS
+                        )
+                        valid = T.meta_var(
+                            entry < T.Cast("int32", unit_meta[head_offsets + layer_id + 1])
+                        )
+                        for chunk in T.serial(head_chunks):
+                            coordinate = T.meta_var(chunk * _LANES + t)
+                            if coordinate < head_dim:
+                                local_z[coordinate] = T.float32(0)
+                                if valid:
+                                    local_z[coordinate] = T.Cast(
+                                        "float32",
+                                        zs[
+                                            last_b,
+                                            last_s,
+                                            T.Cast("int32", unit_meta[head_index + entry]) * head_dim
+                                            + coordinate,
+                                        ],
+                                    )
+                        T.tvm_storage_sync("shared")
+                        acc[0] = T.float32(0)
+                        if valid:
+                            for chunk in T.serial(head_chunks):
+                                a = T.meta_var(chunk * _LANES + t)
+                                if a < head_dim:
+                                    row_acc[0] = T.float32(0)
+                                    for b2 in T.serial(head_dim):
+                                        row_acc[0] = row_acc[0] + grams[entry, a, b2] * local_z[b2]
+                                    acc[0] = acc[0] + local_z[a] * row_acc[0]
+                        partial[t] = acc[0]
+                        T.tvm_storage_sync("shared")
+                        for stage in T.unroll(6):
+                            offset = T.meta_var(32 >> stage)
+                            if t < offset:
+                                partial[t] = partial[t] + partial[t + offset]
+                            T.tvm_storage_sync("shared")
+                        if t == 0:
+                            scale[0] = T.sqrt(T.max(partial[0], T.float32(0)))
+                        T.tvm_storage_sync("shared")
+                        if sandwich:
+                            acc[0] = T.float32(0)
+                            for chunk in T.serial((hidden_size + _LANES - 1) // _LANES):
+                                i = T.meta_var(chunk * _LANES + t)
+                                if i < hidden_size:
+                                    acc[0] = acc[0] + T.Cast("float32", outs[last_b, last_s, i]) * T.Cast(
+                                        "float32", outs[last_b, last_s, i]
+                                    )
+                            partial[t] = acc[0]
+                            T.tvm_storage_sync("shared")
+                            for stage in T.unroll(6):
+                                offset = T.meta_var(32 >> stage)
+                                if t < offset:
+                                    partial[t] = partial[t] + partial[t + offset]
+                                T.tvm_storage_sync("shared")
+                            if T.And(valid, t == 0):
+                                taps[T.Cast("int32", unit_meta[head_slot + entry])] = scale[0] * T.rsqrt(
+                                    partial[0] / T.float32(hidden_size) + T.float32(rms_eps)
+                                )
+                        else:
+                            if T.And(valid, t == 0):
+                                taps[T.Cast("int32", unit_meta[head_slot + entry])] = scale[0]
+
+    return op.tensor_ir_inplace_op(
+        _tap,
+        f"drowse_unit_tap_{layer_id}",
+        args=[z, attn_o, act, sites.unit_meta, sites.tap_grams, sites.taps],
+        inplace_indices=[5],
+        out=Tensor.placeholder((UNIT_MAX_TAPS,), "float32"),
+    )
+
+
+# ----------------------------------------------------------------------------- replay ---
+
+REPLAY_FLAG_ANATOMY = 1
+REPLAY_FLAG_ACTIVITY = 2
+REPLAY_FLAG_PATTERNS = 4
+_FLOAT32_LOWEST = -3.4028234663852886e38
+
+
+def replay_meta_layout() -> dict[str, int]:
+    """Offsets in `replay_meta` (i32; HOOK_ABI.md §7, drowse.ai `replayMetaLayout`)."""
+    spans = 2
+    population_row = spans + 4 * UNIT_MAX_ACTIVITY_SPANS
+    traces = population_row + 2
+    pattern_layer_count = traces + 3 * UNIT_MAX_ACTIVITY_TRACES
+    pattern_layers = pattern_layer_count + 1
+    flags = pattern_layers + UNIT_MAX_PATTERN_LAYERS
+    return {
+        "anatomy_position": 0,
+        "span_count": 1,
+        "spans": spans,
+        "population_row": population_row,
+        "trace_count": population_row + 1,
+        "traces": traces,
+        "pattern_layer_count": pattern_layer_count,
+        "pattern_layers": pattern_layers,
+        "flags": flags,
+        "length": flags + 1,
+    }
+
+
+def anatomy_layout(hidden_size: int, block: dict) -> dict[str, int]:
+    """Per-layer anatomy tap offsets: `block_in | mid | out_pre | out | attn_o | mlp_o | act | z`."""
+    d = hidden_size
+    return {
+        "block_in": 0,
+        "mid": d,
+        "out_pre": 2 * d,
+        "out": 3 * d,
+        "attn_o": 4 * d,
+        "mlp_o": 5 * d,
+        "act": 6 * d,
+        "z": 6 * d + block["d_ff"],
+        "stride": 6 * d + block["d_ff"] + block["n_heads"] * block["head_dim"],
+    }
+
+
+def replay_program_spec(num_layers: int, block: dict) -> dict[str, nn.spec.Tensor]:
+    """The replay arguments after the units program's (B1 §3.4). `traces` and `pattern_keys`
+    are sized by the caller to the replay (`trace_rows` = the node's rows, `pattern_tokens` = the
+    positions fed, 1 when not asked), both at most the context window."""
+    d_ff, heads, kv_heads, head_dim = (
+        block["d_ff"], block["n_heads"], block["n_kv_heads"], block["head_dim"]
+    )
+    return {
+        "replay_meta": nn.spec.Tensor([replay_meta_layout()["length"]], "int32"),
+        "unit_scales": nn.spec.Tensor([num_layers, 2 * d_ff + heads], "float32"),
+        "head_grams": nn.spec.Tensor([num_layers, heads, head_dim, head_dim], "float32"),
+        "activity_state": nn.spec.Tensor([num_layers, 3 * d_ff + 3 * heads], "float32"),
+        "traces": nn.spec.Tensor([UNIT_MAX_ACTIVITY_TRACES, "trace_rows"], "float32"),
+        "population": nn.spec.Tensor([num_layers, d_ff + heads], "float32"),
+        "pattern_keys": nn.spec.Tensor(
+            [UNIT_MAX_PATTERN_LAYERS, kv_heads, "pattern_tokens", head_dim], "float32"
+        ),
+    }
+
+
+def attention_rows_spec(block: dict) -> dict[str, nn.spec.Tensor]:
+    return {
+        "pattern_keys": nn.spec.Tensor(
+            [UNIT_MAX_PATTERN_LAYERS, block["n_kv_heads"], "pattern_tokens", block["head_dim"]],
+            "float32",
+        ),
+        "pattern_q": nn.spec.Tensor(
+            [UNIT_MAX_PATTERN_LAYERS, block["n_heads"], block["head_dim"]], "float32"
+        ),
+        "rows_meta": nn.spec.Tensor([UNIT_MAX_PATTERN_HEADS, 4], "int32"),
+    }
+
+
+def _flag(value, bit: int):
+    return T.floormod(T.floordiv(value, bit), 2) == 1
+
+
+class ReplaySites(UnitSites):
+    """The units forward plus the replay taps (B1 §2.3, §6): anatomy stores at one absolute
+    position, the per-layer unit-activity reduction into a state threaded through the replay's
+    forwards, and the post-RoPE key and query capture at the asked pattern layers."""
+
+    def __init__(
+        self,
+        num_layers: int,
+        hidden_size: int,
+        block: dict,
+        positions: Tensor,
+        unit_meta: Tensor,
+        unit_coeff: Tensor,
+        unit_active: Tensor,
+        tap_grams: Tensor,
+        replay_meta: Tensor,
+        unit_scales: Tensor,
+        head_grams: Tensor,
+        activity_state: Tensor,
+        traces: Tensor,
+        population: Tensor,
+        pattern_keys: Tensor,
+    ):
+        super().__init__(
+            num_layers, block["head_dim"], positions, unit_meta, unit_coeff, unit_active,
+            tap_grams, block["sandwich"], block["rms_eps"],
+        )
+        self.hidden_size = hidden_size
+        self.block = block
+        self.replay_meta = replay_meta
+        self.unit_scales = unit_scales
+        self.head_grams = head_grams
+        self.state = activity_state
+        self.traces = traces
+        self.population = population
+        self.pattern_keys = pattern_keys
+        self.layout = anatomy_layout(hidden_size, block)
+        self.anatomy = op.zeros((num_layers, self.layout["stride"]), "float32")
+        self.pattern_q = op.zeros(
+            (UNIT_MAX_PATTERN_LAYERS, block["n_heads"], block["head_dim"]), "float32"
+        )
+
+    def block_in(self, hidden: Tensor, layer_id: int) -> None:
+        self.anatomy = _anatomy_store(hidden, layer_id, "block_in", self)
+
+    def mid(self, h_mid: Tensor, layer_id: int) -> None:
+        self.anatomy = _anatomy_store(h_mid, layer_id, "mid", self)
+
+    def out_pre(self, hidden: Tensor, layer_id: int) -> None:
+        self.anatomy = _anatomy_store(hidden, layer_id, "out_pre", self)
+
+    def out(self, hidden: Tensor, layer_id: int) -> None:
+        self.anatomy = _anatomy_store(hidden, layer_id, "out", self)
+
+    def mlp(self, mlp_o: Tensor, layer_id: int) -> None:
+        self.anatomy = _anatomy_store(mlp_o, layer_id, "mlp_o", self)
+
+    def tap(self, z: Tensor, attn_o: Tensor, act: Tensor, layer_id: int) -> None:
+        super().tap(z, attn_o, act, layer_id)
+        self.anatomy = _anatomy_store(attn_o, layer_id, "attn_o", self)
+        self.anatomy = _anatomy_store(act, layer_id, "act", self)
+        self.anatomy = _anatomy_store(z, layer_id, "z", self)
+        self.state, self.traces, self.population = _activity_neurons(act, layer_id, self)
+        values = _head_values(z, attn_o, layer_id, self)
+        self.state, self.traces, self.population = _activity_heads(values, layer_id, self)
+
+    def qkv(self, qkv: Tensor, layer_id: int) -> None:
+        self.pattern_keys, self.pattern_q = _pattern_capture(qkv, layer_id, self)
+
+
+def _anatomy_store(x: Tensor, layer_id: int, site: str, sites: ReplaySites) -> Tensor:
+    """Copies `x[row of the anatomy position]` into `anatomy_taps[layer, site]` (in place)."""
+    batch_size, sequence_length, width = x.shape
+    dtype = x.dtype
+    total = batch_size * sequence_length
+    num_layers = sites.num_layers
+    stride = sites.layout["stride"]
+    offset = sites.layout[site]
+    meta = replay_meta_layout()
+    meta_len, at, flags = meta["length"], meta["anatomy_position"], meta["flags"]
+    blocks = (width + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _store(var_x: T.handle, var_positions: T.handle, var_meta: T.handle, var_taps: T.handle):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        values = T.match_buffer(var_x, (batch_size, sequence_length, width), dtype)
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        replay_meta = T.match_buffer(var_meta, (meta_len,), "int32")
+        taps = T.match_buffer(var_taps, (num_layers, stride), "float32")
+        for block in T.thread_binding(blocks, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_anatomy_store"):
+                    k = T.axis.spatial(blocks, block)
+                    t = T.axis.spatial(_LANES, lane)
+                    column = T.meta_var(k * _LANES + t)
+                    row = T.meta_var(replay_meta[at] - positions[0])
+                    if T.And(
+                        T.And(_flag(replay_meta[flags], REPLAY_FLAG_ANATOMY), replay_meta[at] >= 0),
+                        column < width,
+                    ):
+                        if T.And(row >= 0, row < total):
+                            if positions[row] == replay_meta[at]:
+                                taps[layer_id, offset + column] = T.Cast(
+                                    "float32",
+                                    values[
+                                        T.floordiv(row, sequence_length),
+                                        T.floormod(row, sequence_length),
+                                        column,
+                                    ],
+                                )
+
+    return op.tensor_ir_inplace_op(
+        _store,
+        f"drowse_anatomy_{site}_{layer_id}",
+        args=[x, sites.positions, sites.replay_meta, sites.anatomy],
+        inplace_indices=[3],
+        out=Tensor.placeholder((num_layers, stride), "float32"),
+    )
+
+
+def _activity_shapes(sites: ReplaySites) -> dict:
+    d_ff, heads = sites.block["d_ff"], sites.block["n_heads"]
+    return {
+        "num_layers": sites.num_layers,
+        "d_ff": d_ff,
+        "heads": heads,
+        "state_stride": 3 * d_ff + 3 * heads,
+        "scale_stride": 2 * d_ff + heads,
+        "population_stride": d_ff + heads,
+        "context": sites.traces.shape[1],
+        "meta": replay_meta_layout(),
+    }
+
+
+def _activity_neurons(act: Tensor, layer_id: int, sites: ReplaySites):
+    """Per neuron, over the forward's rows in order: `v = act / S_pole` (pole by sign), 0 and
+    rank −1 below `UNIT_POSITIONS_FROM`; the strictly greater `|v|` wins (ties keep the earlier
+    row); the traced neurons' rows and the population row are written as they pass (B1 §2.3)."""
+    batch_size, sequence_length, d_ff = act.shape
+    dtype = act.dtype
+    total = batch_size * sequence_length
+    sh = _activity_shapes(sites)
+    meta = sh["meta"]
+    blocks = (d_ff + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _reduce(
+        var_act: T.handle,
+        var_positions: T.handle,
+        var_meta: T.handle,
+        var_scales: T.handle,
+        var_state: T.handle,
+        var_traces: T.handle,
+        var_population: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        acts = T.match_buffer(var_act, (batch_size, sequence_length, d_ff), dtype)
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        replay_meta = T.match_buffer(var_meta, (meta["length"],), "int32")
+        scales = T.match_buffer(var_scales, (sh["num_layers"], sh["scale_stride"]), "float32")
+        state = T.match_buffer(var_state, (sh["num_layers"], sh["state_stride"]), "float32")
+        traces = T.match_buffer(var_traces, (UNIT_MAX_ACTIVITY_TRACES, sh["context"]), "float32")
+        population = T.match_buffer(
+            var_population, (sh["num_layers"], sh["population_stride"]), "float32"
+        )
+        slot = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        node = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        best = T.sblock_alloc_buffer((5,), "float32", scope="local")
+        for block in T.thread_binding(blocks, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_activity_neurons"):
+                    k = T.axis.spatial(blocks, block)
+                    t = T.axis.spatial(_LANES, lane)
+                    n = T.meta_var(k * _LANES + t)
+                    if T.And(_flag(replay_meta[meta["flags"]], REPLAY_FLAG_ACTIVITY), n < d_ff):
+                        slot[0] = -1
+                        for i in T.serial(UNIT_MAX_ACTIVITY_TRACES):
+                            if T.And(
+                                T.And(
+                                    i < replay_meta[meta["trace_count"]],
+                                    replay_meta[meta["traces"] + 3 * i] == layer_id,
+                                ),
+                                T.And(
+                                    replay_meta[meta["traces"] + 3 * i + 1] == 0,
+                                    replay_meta[meta["traces"] + 3 * i + 2] == n,
+                                ),
+                            ):
+                                if slot[0] < 0:
+                                    slot[0] = i
+                        best[0] = state[layer_id, n]
+                        best[1] = state[layer_id, d_ff + n]
+                        best[2] = state[layer_id, 2 * d_ff + n]
+                        for r in T.serial(total):
+                            node[0] = -1
+                            for span in T.serial(UNIT_MAX_ACTIVITY_SPANS):
+                                if T.And(
+                                    span < replay_meta[meta["span_count"]],
+                                    T.And(
+                                        positions[r] >= replay_meta[meta["spans"] + 4 * span + 2],
+                                        positions[r]
+                                        < replay_meta[meta["spans"] + 4 * span + 2]
+                                        + replay_meta[meta["spans"] + 4 * span + 1],
+                                    ),
+                                ):
+                                    node[0] = (
+                                        replay_meta[meta["spans"] + 4 * span]
+                                        + positions[r]
+                                        - replay_meta[meta["spans"] + 4 * span + 2]
+                                    )
+                            if node[0] >= 0:
+                                best[3] = T.Cast(
+                                    "float32",
+                                    acts[
+                                        T.floordiv(r, sequence_length),
+                                        T.floormod(r, sequence_length),
+                                        n,
+                                    ],
+                                )
+                                if positions[r] < UNIT_POSITIONS_FROM:
+                                    best[3] = T.float32(0)
+                                    best[4] = T.float32(-1)
+                                else:
+                                    if best[3] >= T.float32(0):
+                                        best[3] = best[3] / scales[layer_id, n]
+                                    else:
+                                        best[3] = best[3] / scales[layer_id, d_ff + n]
+                                    best[4] = T.max(best[3], T.float32(0) - best[3])
+                                if best[4] > best[2]:
+                                    best[0] = best[3]
+                                    best[1] = T.Cast("float32", node[0])
+                                    best[2] = best[4]
+                                if T.And(slot[0] >= 0, node[0] < sh["context"]):
+                                    traces[slot[0], node[0]] = best[3]
+                                if node[0] == replay_meta[meta["population_row"]]:
+                                    population[layer_id, n] = best[3]
+                        state[layer_id, n] = best[0]
+                        state[layer_id, d_ff + n] = best[1]
+                        state[layer_id, 2 * d_ff + n] = best[2]
+
+    return op.tensor_ir_inplace_op(
+        _reduce,
+        f"drowse_activity_neurons_{layer_id}",
+        args=[act, sites.positions, sites.replay_meta, sites.unit_scales, sites.state,
+              sites.traces, sites.population],
+        inplace_indices=[4, 5, 6],
+        out=[
+            Tensor.placeholder(sites.state.shape, "float32"),
+            Tensor.placeholder(sites.traces.shape, "float32"),
+            Tensor.placeholder(sites.population.shape, "float32"),
+        ],
+    )
+
+
+def _head_values(z: Tensor, attn_o: Tensor, layer_id: int, sites: ReplaySites) -> Tensor:
+    """`head_values [rows, H]`: every row's scaled write norm
+    `sqrt(max(0, z_hᵀ G_h z_h)) · r_ao / S_h` from the resident `head_grams` (this layer's slice
+    at a constant offset), one workgroup per row; nothing is computed unless activity is asked."""
+    batch_size, sequence_length, width = z.shape
+    hidden_size = attn_o.shape[2]
+    total = batch_size * sequence_length
+    sh = _activity_shapes(sites)
+    meta = sh["meta"]
+    heads, head_dim, d_ff = sh["heads"], sites.head_dim, sh["d_ff"]
+    sandwich, rms_eps = sites.sandwich, sites.rms_eps
+    z_dtype, o_dtype = z.dtype, attn_o.dtype
+    head_chunks = (head_dim + _LANES - 1) // _LANES
+    hidden_chunks = (hidden_size + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _values(
+        var_z: T.handle,
+        var_o: T.handle,
+        var_grams: T.handle,
+        var_scales: T.handle,
+        var_meta: T.handle,
+        var_values: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        zs = T.match_buffer(var_z, (batch_size, sequence_length, width), z_dtype)
+        outs = T.match_buffer(var_o, (batch_size, sequence_length, hidden_size), o_dtype)
+        grams = T.match_buffer(
+            var_grams, (sh["num_layers"], heads, head_dim, head_dim), "float32"
+        )
+        scales = T.match_buffer(var_scales, (sh["num_layers"], sh["scale_stride"]), "float32")
+        replay_meta = T.match_buffer(var_meta, (meta["length"],), "int32")
+        values = T.match_buffer(var_values, (total, heads), "float32")
+        local_z = T.sblock_alloc_buffer((head_dim,), "float32", scope="shared")
+        partial = T.sblock_alloc_buffer((_LANES,), "float32", scope="shared")
+        norm = T.sblock_alloc_buffer((1,), "float32", scope="shared")
+        acc = T.sblock_alloc_buffer((1,), "float32", scope="local")
+        row_acc = T.sblock_alloc_buffer((1,), "float32", scope="local")
+        for row in T.thread_binding(total, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_head_values"):
+                    r = T.axis.spatial(total, row)
+                    t = T.axis.spatial(_LANES, lane)
+                    b = T.meta_var(T.floordiv(r, sequence_length))
+                    s = T.meta_var(T.floormod(r, sequence_length))
+                    # Barriers stay in control flow that depends on the workgroup id only; the
+                    # activity flag guards loads, arithmetic and stores.
+                    active = T.meta_var(_flag(replay_meta[meta["flags"]], REPLAY_FLAG_ACTIVITY))
+                    if t == 0:
+                        norm[0] = T.float32(1)
+                    if sandwich:
+                        acc[0] = T.float32(0)
+                        if active:
+                            for chunk in T.serial(hidden_chunks):
+                                if chunk * _LANES + t < hidden_size:
+                                    acc[0] = acc[0] + T.Cast(
+                                        "float32", outs[b, s, chunk * _LANES + t]
+                                    ) * T.Cast("float32", outs[b, s, chunk * _LANES + t])
+                        partial[t] = acc[0]
+                        T.tvm_storage_sync("shared")
+                        for stage in T.unroll(6):
+                            if t < (32 >> stage):
+                                partial[t] = partial[t] + partial[t + (32 >> stage)]
+                            T.tvm_storage_sync("shared")
+                        if t == 0:
+                            norm[0] = T.rsqrt(
+                                partial[0] / T.float32(hidden_size) + T.float32(rms_eps)
+                            )
+                        T.tvm_storage_sync("shared")
+                    for h in T.serial(heads):
+                        for chunk in T.serial(head_chunks):
+                            if chunk * _LANES + t < head_dim:
+                                local_z[chunk * _LANES + t] = T.float32(0)
+                                if active:
+                                    local_z[chunk * _LANES + t] = T.Cast(
+                                        "float32", zs[b, s, h * head_dim + chunk * _LANES + t]
+                                    )
+                        T.tvm_storage_sync("shared")
+                        acc[0] = T.float32(0)
+                        if active:
+                            for chunk in T.serial(head_chunks):
+                                if chunk * _LANES + t < head_dim:
+                                    row_acc[0] = T.float32(0)
+                                    for c in T.serial(head_dim):
+                                        row_acc[0] = (
+                                            row_acc[0]
+                                            + grams[layer_id, h, chunk * _LANES + t, c] * local_z[c]
+                                        )
+                                    acc[0] = acc[0] + local_z[chunk * _LANES + t] * row_acc[0]
+                        partial[t] = acc[0]
+                        T.tvm_storage_sync("shared")
+                        for stage in T.unroll(6):
+                            if t < (32 >> stage):
+                                partial[t] = partial[t] + partial[t + (32 >> stage)]
+                            T.tvm_storage_sync("shared")
+                        if T.And(active, t == 0):
+                            values[r, h] = (
+                                T.sqrt(T.max(partial[0], T.float32(0)))
+                                * norm[0]
+                                / scales[layer_id, 2 * d_ff + h]
+                            )
+                        T.tvm_storage_sync("shared")
+
+    return op.tensor_ir_op(
+        _values,
+        f"drowse_head_values_{layer_id}",
+        args=[z, attn_o, sites.head_grams, sites.unit_scales, sites.replay_meta],
+        out=Tensor.placeholder((total, heads), "float32"),
+    )
+
+
+def _activity_heads(values: Tensor, layer_id: int, sites: ReplaySites):
+    """The head half of the activity reduction over `head_values` (already scaled)."""
+    total, heads = values.shape
+    sh = _activity_shapes(sites)
+    meta = sh["meta"]
+    d_ff = sh["d_ff"]
+    blocks = (heads + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _reduce(
+        var_values: T.handle,
+        var_positions: T.handle,
+        var_meta: T.handle,
+        var_state: T.handle,
+        var_traces: T.handle,
+        var_population: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        head_values = T.match_buffer(var_values, (total, heads), "float32")
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        replay_meta = T.match_buffer(var_meta, (meta["length"],), "int32")
+        state = T.match_buffer(var_state, (sh["num_layers"], sh["state_stride"]), "float32")
+        traces = T.match_buffer(var_traces, (UNIT_MAX_ACTIVITY_TRACES, sh["context"]), "float32")
+        population = T.match_buffer(
+            var_population, (sh["num_layers"], sh["population_stride"]), "float32"
+        )
+        slot = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        node = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        best = T.sblock_alloc_buffer((5,), "float32", scope="local")
+        for block in T.thread_binding(blocks, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_activity_heads"):
+                    k = T.axis.spatial(blocks, block)
+                    t = T.axis.spatial(_LANES, lane)
+                    h = T.meta_var(k * _LANES + t)
+                    if T.And(_flag(replay_meta[meta["flags"]], REPLAY_FLAG_ACTIVITY), h < heads):
+                        slot[0] = -1
+                        for i in T.serial(UNIT_MAX_ACTIVITY_TRACES):
+                            if T.And(
+                                T.And(
+                                    i < replay_meta[meta["trace_count"]],
+                                    replay_meta[meta["traces"] + 3 * i] == layer_id,
+                                ),
+                                T.And(
+                                    replay_meta[meta["traces"] + 3 * i + 1] == 1,
+                                    replay_meta[meta["traces"] + 3 * i + 2] == h,
+                                ),
+                            ):
+                                if slot[0] < 0:
+                                    slot[0] = i
+                        best[0] = state[layer_id, 3 * d_ff + h]
+                        best[1] = state[layer_id, 3 * d_ff + heads + h]
+                        best[2] = state[layer_id, 3 * d_ff + 2 * heads + h]
+                        for r in T.serial(total):
+                            node[0] = -1
+                            for span in T.serial(UNIT_MAX_ACTIVITY_SPANS):
+                                if T.And(
+                                    span < replay_meta[meta["span_count"]],
+                                    T.And(
+                                        positions[r] >= replay_meta[meta["spans"] + 4 * span + 2],
+                                        positions[r]
+                                        < replay_meta[meta["spans"] + 4 * span + 2]
+                                        + replay_meta[meta["spans"] + 4 * span + 1],
+                                    ),
+                                ):
+                                    node[0] = (
+                                        replay_meta[meta["spans"] + 4 * span]
+                                        + positions[r]
+                                        - replay_meta[meta["spans"] + 4 * span + 2]
+                                    )
+                            if node[0] >= 0:
+                                if positions[r] < UNIT_POSITIONS_FROM:
+                                    best[3] = T.float32(0)
+                                    best[4] = T.float32(-1)
+                                else:
+                                    best[3] = head_values[r, h]
+                                    best[4] = T.max(best[3], T.float32(0) - best[3])
+                                if best[4] > best[2]:
+                                    best[0] = best[3]
+                                    best[1] = T.Cast("float32", node[0])
+                                    best[2] = best[4]
+                                if T.And(slot[0] >= 0, node[0] < sh["context"]):
+                                    traces[slot[0], node[0]] = best[3]
+                                if node[0] == replay_meta[meta["population_row"]]:
+                                    population[layer_id, d_ff + h] = best[3]
+                        state[layer_id, 3 * d_ff + h] = best[0]
+                        state[layer_id, 3 * d_ff + heads + h] = best[1]
+                        state[layer_id, 3 * d_ff + 2 * heads + h] = best[2]
+
+    return op.tensor_ir_inplace_op(
+        _reduce,
+        f"drowse_activity_heads_{layer_id}",
+        args=[values, sites.positions, sites.replay_meta, sites.state, sites.traces,
+              sites.population],
+        inplace_indices=[3, 4, 5],
+        out=[
+            Tensor.placeholder(sites.state.shape, "float32"),
+            Tensor.placeholder(sites.traces.shape, "float32"),
+            Tensor.placeholder(sites.population.shape, "float32"),
+        ],
+    )
+
+
+def _pattern_capture(qkv: Tensor, layer_id: int, sites: ReplaySites):
+    """At an asked pattern layer, every KV head's post-RoPE key for every row of the forward into
+    `pattern_keys[slot, g, position]`, and every query head at the anatomy position into
+    `pattern_q[slot]` (B1 §6). Gemma 3 rotates in the graph (its `qkv` is post-RoPE); a model
+    whose paged KV cache rotates (`RopeMode.NORMAL`: Qwen 3, B40 §7.2) gets the cache's own
+    rotation here, `llama_rope_with_position_map`'s `rope_freq_default` with `rope_scale = 1`, so
+    the keys are the ones the attention kernel read."""
+    batch_size, sequence_length, fused_heads, head_dim = qkv.shape
+    dtype = qkv.dtype
+    total = batch_size * sequence_length
+    block = sites.block
+    heads, kv_heads = block["n_heads"], block["n_kv_heads"]
+    rope = not block["rope_in_graph"]
+    theta = float(block["rope_theta"])
+    half = head_dim // 2
+    context = sites.pattern_keys.shape[2]
+    meta = replay_meta_layout()
+    width = (heads + kv_heads) * head_dim
+    steps = (width + _LANES - 1) // _LANES
+
+    def rotated(x, b, s, head, d, position):
+        if not rope:
+            return T.Cast("float32", x[b, s, head, d])
+        freq = (T.Cast("float32", position) * T.float32(1.0)) / tirx.power(
+            T.float32(theta), T.Cast("float32", T.floormod(d * 2, head_dim)) / T.float32(head_dim)
+        )
+        paired = T.if_then_else(
+            d < half, T.Cast("float32", -x[b, s, head, d + half]),
+            T.Cast("float32", x[b, s, head, d - half]),
+        )
+        return T.Cast(
+            "float32",
+            T.Cast(dtype, T.cos(freq) * T.Cast("float32", x[b, s, head, d]) + T.sin(freq) * paired),
+        )
+
+    @T.prim_func(private=True, s_tir=True)
+    def _capture(
+        var_qkv: T.handle,
+        var_positions: T.handle,
+        var_meta: T.handle,
+        var_keys: T.handle,
+        var_queries: T.handle,
+    ):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        x = T.match_buffer(var_qkv, (batch_size, sequence_length, fused_heads, head_dim), dtype)
+        positions = T.match_buffer(var_positions, (total,), "int32")
+        replay_meta = T.match_buffer(var_meta, (meta["length"],), "int32")
+        keys = T.match_buffer(
+            var_keys, (UNIT_MAX_PATTERN_LAYERS, kv_heads, context, head_dim), "float32"
+        )
+        queries = T.match_buffer(var_queries, (UNIT_MAX_PATTERN_LAYERS, heads, head_dim), "float32")
+        slot = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        for row in T.thread_binding(total, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_pattern_capture"):
+                    r = T.axis.spatial(total, row)
+                    t = T.axis.spatial(_LANES, lane)
+                    b = T.meta_var(T.floordiv(r, sequence_length))
+                    s = T.meta_var(T.floormod(r, sequence_length))
+                    slot[0] = -1
+                    for i in T.serial(UNIT_MAX_PATTERN_LAYERS):
+                        if T.And(
+                            i < replay_meta[meta["pattern_layer_count"]],
+                            replay_meta[meta["pattern_layers"] + i] == layer_id,
+                        ):
+                            slot[0] = i
+                    if T.And(
+                        T.And(_flag(replay_meta[meta["flags"]], REPLAY_FLAG_PATTERNS), slot[0] >= 0),
+                        T.And(positions[r] >= 0, positions[r] < context),
+                    ):
+                        for step in T.serial(steps):
+                            if step * _LANES + t < width:
+                                if T.floordiv(step * _LANES + t, head_dim) >= heads:
+                                    keys[
+                                        slot[0],
+                                        T.floordiv(step * _LANES + t, head_dim) - heads,
+                                        positions[r],
+                                        T.floormod(step * _LANES + t, head_dim),
+                                    ] = rotated(
+                                        x, b, s, T.floordiv(step * _LANES + t, head_dim),
+                                        T.floormod(step * _LANES + t, head_dim), positions[r],
+                                    )
+                                elif positions[r] == replay_meta[meta["anatomy_position"]]:
+                                    queries[
+                                        slot[0],
+                                        T.floordiv(step * _LANES + t, head_dim),
+                                        T.floormod(step * _LANES + t, head_dim),
+                                    ] = rotated(
+                                        x, b, s, T.floordiv(step * _LANES + t, head_dim),
+                                        T.floormod(step * _LANES + t, head_dim), positions[r],
+                                    )
+
+    return op.tensor_ir_inplace_op(
+        _capture,
+        f"drowse_pattern_capture_{layer_id}",
+        args=[qkv, sites.positions, sites.replay_meta, sites.pattern_keys, sites.pattern_q],
+        inplace_indices=[3, 4],
+        out=[
+            Tensor.placeholder(sites.pattern_keys.shape, "float32"),
+            Tensor.placeholder(sites.pattern_q.shape, "float32"),
+        ],
+    )
+
+
+def attention_rows(pattern_keys: Tensor, pattern_q: Tensor, rows_meta: Tensor, block: dict) -> Tensor:
+    """`drowse_attention_rows`: for each `(slot, layer, head, p)` of `rows_meta` (slot −1 unused),
+    `a_j = softmax_j(q_p·k_j · scaling)` over `j ≤ p` (on a local layer also `j > p − W`), fp32,
+    0 elsewhere → `[MAX_PATTERN_HEADS, context]` (B1 §6)."""
+    slots, kv_heads, context, head_dim = pattern_keys.shape
+    heads = block["n_heads"]
+    group = heads // kv_heads
+    scaling = float(block["attn_scaling"])
+    window = int(block.get("sliding_window") or 0)
+    pattern = int(block.get("sliding_pattern") or 0)
+    rows = UNIT_MAX_PATTERN_HEADS
+    steps = (context + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _rows(var_keys: T.handle, var_q: T.handle, var_meta: T.handle, var_out: T.handle):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        keys = T.match_buffer(var_keys, (slots, kv_heads, context, head_dim), "float32")
+        queries = T.match_buffer(var_q, (slots, heads, head_dim), "float32")
+        meta = T.match_buffer(var_meta, (rows, 4), "int32")
+        out = T.match_buffer(var_out, (rows, context), "float32")
+        partial = T.sblock_alloc_buffer((_LANES,), "float32", scope="shared")
+        reduced = T.sblock_alloc_buffer((2,), "float32", scope="shared")
+        acc = T.sblock_alloc_buffer((2,), "float32", scope="local")
+        lo = T.sblock_alloc_buffer((1,), "int32", scope="local")
+        for row in T.thread_binding(rows, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_attention_rows"):
+                    i = T.axis.spatial(rows, row)
+                    t = T.axis.spatial(_LANES, lane)
+                    valid = T.meta_var(
+                        T.And(
+                            T.And(meta[i, 0] >= 0, meta[i, 0] < slots),
+                            T.And(
+                                T.And(meta[i, 2] >= 0, meta[i, 2] < heads),
+                                T.And(meta[i, 3] >= 0, meta[i, 3] < context),
+                            ),
+                        )
+                    )
+                    lo[0] = 0
+                    if pattern > 0:
+                        if T.floormod(meta[i, 1] + 1, pattern) != 0:
+                            lo[0] = meta[i, 3] - window + 1
+                    acc[0] = T.float32(_FLOAT32_LOWEST)
+                    for step in T.serial(steps):
+                        if step * _LANES + t < context:
+                            out[i, step * _LANES + t] = T.float32(0)
+                            if T.And(
+                                valid,
+                                T.And(step * _LANES + t >= lo[0], step * _LANES + t <= meta[i, 3]),
+                            ):
+                                acc[1] = T.float32(0)
+                                for d in T.serial(head_dim):
+                                    acc[1] = acc[1] + queries[meta[i, 0], meta[i, 2], d] * keys[
+                                        meta[i, 0], T.floordiv(meta[i, 2], group),
+                                        step * _LANES + t, d,
+                                    ]
+                                out[i, step * _LANES + t] = acc[1] * T.float32(scaling)
+                                acc[0] = T.max(acc[0], out[i, step * _LANES + t])
+                    partial[t] = acc[0]
+                    T.tvm_storage_sync("shared")
+                    for stage in T.unroll(6):
+                        if t < (32 >> stage):
+                            partial[t] = T.max(partial[t], partial[t + (32 >> stage)])
+                        T.tvm_storage_sync("shared")
+                    if t == 0:
+                        reduced[0] = partial[0]
+                    T.tvm_storage_sync("shared")
+                    acc[0] = T.float32(0)
+                    for step in T.serial(steps):
+                        if step * _LANES + t < context:
+                            if T.And(
+                                valid,
+                                T.And(step * _LANES + t >= lo[0], step * _LANES + t <= meta[i, 3]),
+                            ):
+                                out[i, step * _LANES + t] = T.exp(
+                                    out[i, step * _LANES + t] - reduced[0]
+                                )
+                                acc[0] = acc[0] + out[i, step * _LANES + t]
+                    partial[t] = acc[0]
+                    T.tvm_storage_sync("shared")
+                    for stage in T.unroll(6):
+                        if t < (32 >> stage):
+                            partial[t] = partial[t] + partial[t + (32 >> stage)]
+                        T.tvm_storage_sync("shared")
+                    if t == 0:
+                        reduced[1] = partial[0]
+                    T.tvm_storage_sync("shared")
+                    for step in T.serial(steps):
+                        if step * _LANES + t < context:
+                            if T.And(
+                                valid,
+                                T.And(step * _LANES + t >= lo[0], step * _LANES + t <= meta[i, 3]),
+                            ):
+                                out[i, step * _LANES + t] = out[i, step * _LANES + t] / reduced[1]
+
+    return op.tensor_ir_op(
+        _rows,
+        "drowse_attention_rows",
+        args=[pattern_keys, pattern_q, rows_meta],
+        out=Tensor.placeholder((rows, context), "float32"),
+    )
+
+
+def dequantized_weight(linear) -> Tensor:
+    """A linear layer's weight `[out, in]` in fp32 as its forward reads it: a plain weight, or a
+    group-quantized one through the quantization config's own `_dequantize` (B40 §7.4)."""
+    if hasattr(linear, "q_weight") and hasattr(linear, "q_scale"):
+        config = linear.config
+        if config.linear_weight_layout != "NK":
+            raise ValueError("drowse static reads expect NK group-quantized weights")
+        weight = nn.op.tensor_expr_op(
+            lambda w, s: config._dequantize(
+                w, s, axis=config.linear_quant_axis,
+                out_shape=[
+                    tirx.IntImm("int64", linear.out_features),
+                    tirx.IntImm("int64", linear.in_features),
+                ],
+            ),
+            name_hint="dequantize",
+            args=[linear.q_weight, linear.q_scale],
+        )
+    elif hasattr(linear, "weight") and not hasattr(linear, "q_weight"):
+        weight = linear.weight
+    else:
+        raise ValueError(f"drowse static reads cannot dequantize {type(linear).__name__}")
+    return weight.astype("float32") if weight.dtype != "float32" else weight
+
+
+def head_write_grams(model) -> Tensor:
+    """`drowse_head_write_grams`: `G_h = Bᵀ B`, `B = γ_ao ⊙ W_O[:, h·hd:(h+1)·hd]` (γ_ao the
+    attention-output norm's gain on a sandwich block, 1 otherwise), every head of every layer,
+    fp32 from the weights the library runs, written per layer into one `[L, H, hd, hd]` buffer."""
+    block = model._drowse_block_spec()
+    num_layers = model.num_hidden_layers
+    grams = op.zeros((num_layers, block["n_heads"], block["head_dim"], block["head_dim"]), "float32")
+    for layer_id, layer in enumerate(model.model.layers):
+        weight = dequantized_weight(layer.self_attn.o_proj)
+        if block["sandwich"]:
+            gamma = layer.post_attention_layernorm.weight
+            gamma = gamma.astype("float32") if gamma.dtype != "float32" else gamma
+            weight = weight * op.reshape(gamma, (weight.shape[0], 1))
+        grams = _gram_store(weight, grams, layer_id)
+    return grams
+
+
+def _gram_store(weight: Tensor, grams: Tensor, layer_id: int) -> Tensor:
+    """`grams[layer, h, i, j] = Σ_k W[k, h·hd + i] · W[k, h·hd + j]`, one workgroup per `(h, i)`
+    (a TIR kernel, not a Relax matmul: MLC's dequantize-matmul fusion would fold the two uses of
+    the dequantized weight into one group)."""
+    num_layers, heads, head_dim, _ = grams.shape
+    hidden_size = weight.shape[0]
+    rows = heads * head_dim
+    chunks = (head_dim + _LANES - 1) // _LANES
+
+    @T.prim_func(private=True, s_tir=True)
+    def _store(var_weight: T.handle, var_grams: T.handle):
+        T.func_attr({"op_pattern": 8, "tirx.is_scheduled": 1, "tirx.noalias": True})
+        w = T.match_buffer(var_weight, (hidden_size, rows), "float32")
+        output = T.match_buffer(var_grams, (num_layers, heads, head_dim, head_dim), "float32")
+        acc = T.sblock_alloc_buffer((1,), "float32", scope="local")
+        for block in T.thread_binding(rows, thread="blockIdx.x"):
+            for lane in T.thread_binding(_LANES, thread="threadIdx.x"):
+                with T.sblock("drowse_head_write_gram"):
+                    r = T.axis.spatial(rows, block)
+                    t = T.axis.spatial(_LANES, lane)
+                    for chunk in T.serial(chunks):
+                        if chunk * _LANES + t < head_dim:
+                            acc[0] = T.float32(0)
+                            for k in T.serial(hidden_size):
+                                acc[0] = acc[0] + w[k, r] * w[
+                                    k, T.floordiv(r, head_dim) * head_dim + chunk * _LANES + t
+                                ]
+                            output[
+                                layer_id, T.floordiv(r, head_dim), T.floormod(r, head_dim),
+                                chunk * _LANES + t,
+                            ] = acc[0]
+
+    return op.tensor_ir_inplace_op(
+        _store,
+        f"drowse_head_write_gram_{layer_id}",
+        args=[weight, grams],
+        inplace_indices=[1],
+        out=Tensor.placeholder(grams.shape, "float32"),
+    )
