{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drowse:schema:browser-runtime-evidence-v4",
  "title": "Hook ABI v5 runtime evidence ledger",
  "description": "References to the release evidence records of one tested revision (README.md, \"Release evidence\"): the units goldens on the C TVM VM and on WebGPU over the four fixture libraries, then, optionally, per production library its physical runtime record and, for a q4 library, its q4 parity record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "drowseRevision", "gates", "libraries"],
  "properties": {
    "$schema": { "const": "./runtime-evidence.schema.json" },
    "schemaVersion": { "const": 4 },
    "status": { "enum": ["feasibility-required", "verified"] },
    "drowseRevision": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git commit whose executable source produced the referenced evidence"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cVmGoldens", "webGpuGoldens"],
      "properties": {
        "cVmGoldens": { "$ref": "#/$defs/reference" },
        "webGpuGoldens": { "$ref": "#/$defs/reference" }
      }
    },
    "libraries": {
      "description": "Keyed by runtime-lock model id.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productionLibrary"],
        "properties": {
          "productionLibrary": { "$ref": "#/$defs/reference" },
          "productionQ4Parity": { "$ref": "#/$defs/reference" }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^evidence/[a-z0-9][a-z0-9._/-]*\\.json$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
